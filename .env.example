# Copie este archivo como .env y ajuste los valores

# --- SQL Server ---
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=TecnoHogarDB
# El driver "mssql" usa usuario y contraseña de SQL Server (habilite autenticación mixta y el usuario sa,
# o cree un usuario propio). Si usa una instancia con nombre (ej. SQLEXPRESS) ponga SQL_INSTANCE.
SQL_USER=sa
SQL_PASSWORD=TuClaveSegura123
SQL_INSTANCE=
SQL_ENCRYPT=false

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tecnohogar

# --- Interfaz web ---
PORT=3000
